<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="NekoSimulator233" Manufacturer="neko233" Version="$(var.Version)" UpgradeCode="92e48fc1-263e-4f72-87c4-d23e3b10fa23" Scope="perUser">
    <MajorUpgrade DowngradeErrorMessage="A newer version of NekoSimulator233 is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="NekoSimulator233">
        <Component Id="Application" Guid="7b9625da-ee59-4028-a29a-92c495631602">
          <File Id="ApplicationExe" Source="$(var.Exe)" />
          <RegistryValue Root="HKCU" Key="Software\Neko233\NekoSimulator233" Name="ApplicationInstalled" Type="integer" Value="1" KeyPath="yes" />
          <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        </Component>
        <Component Id="AgentServer" Guid="4bd490b9-a956-4db5-8aeb-2b27e6d3de61">
          <File Id="AgentExe" Source="$(var.McpExe)" />
          <RegistryValue Root="HKCU" Key="Software\Neko233\NekoSimulator233" Name="AgentInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <Component Id="MyGoLicense" Guid="5aece479-89f7-41d2-bd2c-f3d7cf7f87bd">
          <File Id="MyGoLicenseFile" Name="LICENSE-MyGo.txt" Source="$(var.MyGoLicense)" />
          <RegistryValue Root="HKCU" Key="Software\Neko233\NekoSimulator233" Name="MyGoLicenseInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <Component Id="JDKConfigurator" Guid="0fcf920e-0c26-4db6-a542-8677f896fa23">
          <File Id="JDKConfiguratorScript" Name="configure-jdk.ps1" Source="$(var.ConfigureJDK)" />
          <RegistryValue Root="HKCU" Key="Software\Neko233\NekoSimulator233" Name="JDKConfiguratorInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <?if $(var.IncludeRuntime) = 1 ?>
        <Component Id="AndroidRuntime" Guid="6baaece2-071f-4479-9e1b-bd6d6479b847">
          <File Id="AndroidRuntimeBundle" Name="android-runtime.zip" Source="$(var.RuntimeBundle)" />
          <RegistryValue Root="HKCU" Key="Software\Neko233\NekoSimulator233" Name="RuntimeInstalled" Type="integer" Value="1" KeyPath="yes" />
        </Component>
        <?endif?>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ProgramMenuApp" Name="NekoSimulator233">
        <Component Id="Shortcut" Guid="*">
          <Shortcut Id="StartMenuShortcut" Name="NekoSimulator233" Target="[INSTALLFOLDER]NekoSimulator233.exe" WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveProgramMenuApp" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Neko233\NekoSimulator233" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main"><ComponentRef Id="Application" /><ComponentRef Id="AgentServer" /><ComponentRef Id="MyGoLicense" /><ComponentRef Id="JDKConfigurator" /><ComponentRef Id="Shortcut" /><?if $(var.IncludeRuntime) = 1 ?><ComponentRef Id="AndroidRuntime" /><?endif?></Feature>
  </Package>
</Wix>
